# =======================================================================
# OutSail Blueprint — environment variables
# =======================================================================
# Copy to .env.local for local development. Variables marked "REQUIRED AT
# BOOT" below MUST be set or the app refuses to start (it now fails closed
# rather than falling back to insecure defaults).

# -----------------------------------------------------------------------
# Turso (libSQL) database
# -----------------------------------------------------------------------
# When deployed on Vercel with the Turso integration, these variables are
# injected automatically with a "blueprint_" prefix (matching the Vercel
# project name). The app checks the prefixed name first, then falls back
# to the unprefixed name for local dev or other hosting environments.
#
# Vercel (auto-injected by Turso integration):
#   blueprint_TURSO_DATABASE_URL=libsql://...
#   blueprint_TURSO_AUTH_TOKEN=eyJ...
#
# Local dev / non-Vercel environments:
# REQUIRED AT BOOT — the DB client throws on import if the URL is missing.
TURSO_DATABASE_URL=libsql://your-database.turso.io
# Auth token for the remote database (required for any non-file libSQL URL).
TURSO_AUTH_TOKEN=your-auth-token

# -----------------------------------------------------------------------
# Auth — token signing keys
# -----------------------------------------------------------------------
# Two INDEPENDENT secrets, one per token class, so a magic-link token can
# never be replayed as a session token (or vice versa). The app throws at
# startup if either is unset — there is no insecure fallback.
# Generate each with: openssl rand -base64 32
#
# REQUIRED AT BOOT — signs the 30-day session cookie (outsail_session).
NEXTAUTH_SECRET=your-32-char-secret-here
# REQUIRED AT BOOT — signs the 15-minute magic-link tokens. Use a DIFFERENT
# value from NEXTAUTH_SECRET.
MAGIC_LINK_SECRET=another-distinct-32-char-secret

# -----------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------
# Used to send magic links and notification emails. Optional at boot; email
# delivery is skipped/fails if unset.
RESEND_API_KEY=re_your_api_key

# -----------------------------------------------------------------------
# AI (Anthropic Claude)
# -----------------------------------------------------------------------
# Server-side only. Optional at boot; AI routes return 503 if unset.
ANTHROPIC_API_KEY=sk-ant-your-key

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------
# Base URL used to build magic-link and notification URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
